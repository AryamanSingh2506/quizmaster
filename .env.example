# ============================================================
# Google Gemini AI API Configuration
# ============================================================
# Obtain your Gemini API Key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
PORT=3000

# ============================================================
# Firebase Configuration (Cloud Firestore & Authentication)
# ============================================================
# Obtain these from Firebase Console:
# Project Settings -> General -> Your apps -> Web app
# Keeping these in .env prevents leaking keys into public Git repositories!
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
